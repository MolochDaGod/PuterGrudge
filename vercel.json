{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public-vercel-edge",
  "installCommand": "echo skip",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Puter-Monitor-Edge", "value": "proxy-to-render" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "https://puter-monitor-ai.onrender.com/"
    },
    {
      "source": "/:path*",
      "destination": "https://puter-monitor-ai.onrender.com/:path*"
    }
  ]
}
