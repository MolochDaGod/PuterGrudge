{
  "name": "puter-monitor-ai",
  "version": "3.0.0",
  "title": "Puter Monitor AI — GrudgeOS",
  "description": "Grudge Studio collaborative WebOS: free Puter AI, fleet games (Warlords/Open/Forge), cloud tools, agent ops.",
  "type": "app",
  "index": "dist/edge/puter-app-dist/index.html",
  "icon": "public/grudgeos/pwa-512x512.png",
  "permissions": ["ai", "fs", "kv", "auth", "hosting"],
  "auth": {
    "provider": "puter",
    "integration": "grudge-id-optional"
  },
  "routes": {
    "/": { "static": "dist/edge" },
    "/api/*": { "proxy": "https://puter-monitor-ai.onrender.com/api" }
  },
  "deployment": {
    "strategy": "static+proxy",
    "healthcheck": "https://puter-monitor-ai.onrender.com/api/health",
    "production": {
      "vercel": "https://puter-monitor-ai.vercel.app",
      "render": "https://puter-monitor-ai.onrender.com"
    }
  },
  "fleet": {
    "warlords": "https://grudgewarlords.com",
    "open": "https://open.grudge-studio.com",
    "forge": "https://forge.grudge-studio.com",
    "id": "https://id.grudge-studio.com",
    "ai": "https://ai.grudge-studio.com"
  }
}
